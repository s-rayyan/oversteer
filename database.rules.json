{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['x', 'y', 'h', 'p', 'd', 'at'])",
          "x": { ".validate": "newData.isNumber()" },
          "y": { ".validate": "newData.isNumber()" },
          "h": { ".validate": "newData.isNumber()" },
          "p": { ".validate": "newData.isNumber()" },
          "t": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 12000 && newData.val() < 3600000 && newData.val() % 1 == 0)" },
          "d": { ".validate": "newData.isBoolean()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
