rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player per board: boards/{track id | 'endless'}/scores/{auth uid}
    match /boards/{board}/scores/{uid} {
      allow read: if true;
      allow create: if signedIn(uid) && validScore(board);
      allow update: if signedIn(uid) && validScore(board) && notWorse(board);
      allow delete: if false;

      function signedIn(u) {
        return request.auth != null && request.auth.uid == u;
      }

      function validScore(b) {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'value', 'updatedAt'])
          && d.uid == request.auth.uid
          && d.name is string && d.name.matches('^[A-Za-z0-9 _.-]{1,12}$') // same characters as sanitizeName
          && d.value is int
          && ((b == 'endless' || b == 'oversteer')
                ? (d.value > 0 && d.value < 500000)               // metres
                : (d.value >= minTime(b) && d.value < 3600000))   // race time, ms
          && d.updatedAt == request.time;
      }

      // Fastest believable race time per track, in ms: half the time it takes to drive the centre line at the fastest
      // car's top boosted speed, so cutting corners still fits easily but a made-up 5-second race doesn't. A board
      // that isn't a real track gets 3600000, which no score can pass (it must also be below 3600000).
      // Generated by `npm run check:rules -- --write`; do not edit by hand.
      function minTime(b) {
        // BEGIN GENERATED
        return {
          'sunset-oval': 12800,
          'meadow-loop': 13600,
          'lakeside': 12800,
          'hilltop-cruise': 16200,
          'harbor-run': 16200,
          'dune-run': 14100,
          'canyon-hairpin': 14300,
          'mesa-sprint': 15400,
          'oasis-loop': 18400,
          'dust-bowl': 13900,
          'mountain-pass': 14500,
          'switchbacks': 16300,
          'glacier-descent': 16400,
          'ice-tunnel': 12800,
          'summit': 14900,
          'serpent': 18300,
          'gauntlet': 15900,
          'spaghetti': 12300,
          'neon-loop': 14500,
          'razor': 16800,
          'hairpin-alley': 19300,
          'gravel-rally': 19800,
          'boost-highway': 20200,
          'drift-ring': 20400,
          'grand-tour': 19800
        }.get(b, 3600000);
        // END GENERATED
      }

      // Time boards: lower is better. Endless: higher is better.
      function notWorse(b) {
        return (b == 'endless' || b == 'oversteer')
          ? request.resource.data.value >= resource.data.value
          : request.resource.data.value <= resource.data.value;
      }
    }

    // Replays of race runs: boards/{track id}/ghosts/{auth uid}. A replay is only accepted if its time equals
    // the player's leaderboard score for that track, so nobody can attach a faster-looking run than they set.
    match /boards/{board}/ghosts/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && board != 'endless' && board != 'oversteer'
        && validGhost(board, uid);
      allow delete: if false;

      function validGhost(b, u) {
        let d = request.resource.data;
        let score = get(/databases/$(database)/documents/boards/$(b)/scores/$(u)).data;
        return d.keys().hasOnly(['uid', 'name', 'time', 'carId', 'data', 'updatedAt'])
          && d.uid == u
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.time is int && d.time == score.value
          && d.carId is string && d.carId.size() <= 24
          && d.data is string && d.data.size() > 20 && d.data.size() <= 600000
          && d.updatedAt == request.time;
      }
    }

    // Head-to-head races. rooms/{code} is the lobby and roster; rooms/{code}/live/{uid} is each driver's car position,
    // rewritten a few times a second while racing. Finish times are reported by the drivers themselves (the same caveat
    // as the leaderboard: the rules only bound them), and a race pays coins by finishing place, not by time.
    match /rooms/{room} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['track', 'host', 'public', 'status', 'createdAt', 'startedAt', 'players', 'expireAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.track is string && request.resource.data.track.size() <= 24
        && request.resource.data.public is bool
        && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time
        && request.resource.data.startedAt == null
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(2, 'd') // a TTL policy on this field deletes old rooms
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() == 1
        && validMember(request.resource.data.players[request.auth.uid]);
      allow update: if request.auth != null && (
        // join, heartbeat or leave: while in the lobby, only our own roster entry changes, and the room holds at most 4
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
          && resource.data.status == 'lobby'
          && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.players.size() <= 4
          && (!(request.auth.uid in request.resource.data.players) || validMember(request.resource.data.players[request.auth.uid])))
        // start: a driver in the room, with at least one opponent, flips it to racing
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt'])
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'racing'
          && request.resource.data.startedAt == request.time
          && request.auth.uid in resource.data.players
          && resource.data.players.size() >= 2));
      allow delete: if false;

      function validMember(m) {
        return m.keys().hasOnly(['name', 'carId', 'at'])
          && m.name is string && m.name.matches('^[A-Za-z0-9 _.-]{1,12}$')
          && m.carId is string && m.carId.size() <= 24
          && m.at is int;
      }

      match /live/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['x', 'y', 'h', 'p', 't', 'd', 'at'])
          && request.resource.data.x is number && request.resource.data.y is number
          && request.resource.data.h is number && request.resource.data.p is number
          && (request.resource.data.t == null || (request.resource.data.t is int && request.resource.data.t >= 12000 && request.resource.data.t < 3600000))
          && request.resource.data.d is bool
          && request.resource.data.at is int;
        allow delete: if false;
      }
    }

    // The newest public lobby, announced to everyone online so they can be offered a game: one document, overwritten
    // by whoever opens a public room, watched by every client. Players can only name themselves as the host.
    match /lobbyBeacon/{doc} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && doc == 'latest'
        && request.resource.data.keys().hasOnly(['room', 'track', 'name', 'host', 'at'])
        && request.resource.data.room is string && request.resource.data.room.size() == 5
        && request.resource.data.track is string && request.resource.data.track.size() <= 24
        && request.resource.data.name is string && request.resource.data.name.matches('^[A-Za-z0-9 _.-]{1,12}$')
        && request.resource.data.host == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // Optional online account save: users/{auth uid}. Only its owner can read or write it, and only once
    // signed in to an account (not as an anonymous player).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['v', 'data', 'updatedAt'])
        && request.resource.data.v == 1
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 100000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
