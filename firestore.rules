rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player per board: boards/{track id | 'endless'}/scores/{auth uid}
    match /boards/{board}/scores/{uid} {
      allow read: if true;
      allow create: if signedIn(uid) && validScore(board);
      allow update: if signedIn(uid) && validScore(board) && notWorse(board);
      allow delete: if false;

      function signedIn(u) {
        return request.auth != null && request.auth.uid == u;
      }

      function validScore(b) {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'name', 'value', 'updatedAt'])
          && d.uid == request.auth.uid
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.value is int
          && ((b == 'endless' || b == 'oversteer')
                ? (d.value > 0 && d.value < 500000)               // metres
                : (d.value >= 5000 && d.value < 3600000))         // race time, ms
          && d.updatedAt == request.time;
      }

      // Time boards: lower is better. Endless: higher is better.
      function notWorse(b) {
        return (b == 'endless' || b == 'oversteer')
          ? request.resource.data.value >= resource.data.value
          : request.resource.data.value <= resource.data.value;
      }
    }
  }
}
